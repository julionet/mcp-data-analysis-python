SERVER_HOST=0.0.0.0
SERVER_PORT=3000
TLS_ENABLED=false
TLS_CERT_FILE=certs/server.pem
TLS_KEY_FILE=certs/server-key.pem
POSTGRES_CONFIG_HOST=localhost
POSTGRES_CONFIG_PORT=5433
POSTGRES_CONFIG_DATABASE=analysis_config
POSTGRES_CONFIG_USER=postgres
POSTGRES_CONFIG_PASSWORD=changeme
DEFAULT_MAX_RESULT_ROWS=500
DEFAULT_MAX_RESULT_SIZE_KB=150
QUERY_TIMEOUT_SECONDS=30
# Retry automático só de falha rápida de conexão ao data source (nunca de timeout,
# erro de SQL ou validação). MAX_ATTEMPTS = total de tentativas (1 = sem retry);
# espera entre tentativas = BASE_MS * 2^(tentativa-1) (200 ms, 400 ms, ...)
QUERY_RETRY_MAX_ATTEMPTS=3
QUERY_RETRY_BACKOFF_BASE_MS=200
# Pool PostgreSQL (F15): PG_POOL_* = cada data source PostgreSQL; CONFIG_DB_POOL_* = Config DB.
# Padrão 10/10 = comportamento anterior. MIN >= 1 e MAX >= MIN. Some os MAX dos pools e
# confira o max_connections do PostgreSQL. Por data source: pool_min_size/pool_max_size
# no connection_config sobrepõem PG_POOL_*.
PG_POOL_MIN_SIZE=10
PG_POOL_MAX_SIZE=10
CONFIG_DB_POOL_MIN_SIZE=10
CONFIG_DB_POOL_MAX_SIZE=10
FERNET_KEY=sua_chave_fernet_aqui
# CACHE_BACKEND=memory (padrão) ou none (desliga o cache globalmente, para
# todas as análises, sem tocar em analyses.cache_frequency no banco)
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=200
CACHE_MAX_SIZE_MB=100
ACCESS_TOKEN_EXPIRATION_DAYS=90
ACCESS_TOKEN_MAX_EXPIRATION_DAYS=365

# F16 — Swagger (/docs, /redoc, /openapi.json). SÓ em ambiente local: padrão false (404 nas 3 URLs).
# Os compose remote e dist não repassam esta variável ao app, então ficam sem Swagger.
DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# F13 — Docker (docker-compose.local.yml / docker-compose.remote.yml)
# Para o compose: cp .env.example .env   (raiz do repositório; é o ÚNICO .env)
# Um arquivo só para os dois modos:
#  - host:    python src/run_https.py  → usa POSTGRES_CONFIG_HOST=localhost e a porta 5433
#            (o postgres do compose publicado no host: docker compose up -d postgres);
#  - compose: o app roda com POSTGRES_CONFIG_HOST=postgres e porta 5432, forçados nos
#            próprios compose (ignoram os valores acima); o resto vem daqui por interpolação.
# ---------------------------------------------------------------------------

# Administrador criado na criação do banco (src/database/seed_admin.sh, só no compose local).
# SENHA PADRÃO CONHECIDA (Senh@123): troque em qualquer ambiente acessível por outras pessoas.
# Com "$" na senha, escreva "$$" (interpolação do compose). Mudar aqui NÃO altera um admin que já
# existe: use  ./scripts/setup-admin.sh --no-up --password 'nova' --reset-password  (Windows: .\scripts\setup-admin.ps1 -NoUp -Password 'nova' -ResetPassword)
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=Senh@123

# Data sources opcionais — FORA dos compose; descomente só o que for subir à mão.
# Por padrão a aplicação usa apenas o PostgreSQL. Cada banco tem o próprio compose em docker/<banco>/:
#   docker compose --env-file .env -f docker/<banco>/docker-compose.<banco>.yml up -d
# MySQL (docker/mysql/)
# MYSQL_ROOT_PASSWORD=changeme
# MYSQL_DATABASE=analysis_data
# SQL Server (docker/sqlserver/) — exige senha forte
# MSSQL_SA_PASSWORD=Changeme_123!
# Oracle (docker/oracle/)
# ORACLE_PASSWORD=changeme

# Portas publicadas no host (só no compose local)
POSTGRES_HOST_PORT=5433              # 5433 evita colisão com PostgreSQL instalado no host
# Dos bancos opcionais (só se subir):
# MYSQL_HOST_PORT=3306
# MSSQL_HOST_PORT=1433
# ORACLE_HOST_PORT=1521

# Remote (nginx; certificado montado em certs/ por ora). TLS_ENABLED=false
# é aplicado ao app pelo próprio docker-compose.remote.yml.
# NGINX_SERVER_NAME=_
# NGINX_CERT_FILE=/etc/nginx/certs/server.pem
# NGINX_KEY_FILE=/etc/nginx/certs/server-key.pem

# Certbot (DNS-01) só com --profile certbot — descomentar quando houver domínio/DNS:
# DOMAIN_NAME=analise.empresa.internal
# CERTBOT_EMAIL=ops@empresa.com
# CERTBOT_DNS_PROVIDER=cloudflare      # provedor definido na operação
# CERTBOT_DNS_CREDENTIALS=./secrets/certbot-dns.ini
# Portas do nginx no host (remote). Mude se 80/443 estiverem ocupadas/reservadas (ex.: Windows).
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
