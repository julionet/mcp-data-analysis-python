# Contexto de build = raiz. A imagem só usa requirements.txt e src/ (COPY explícito),
# o resto fica fora para o build ser rápido e nada sensível sair do host.

# Secrets e certificados nunca entram na imagem (F13 §2)
.env
.env.*
!.env.example
certs/

# Ambiente e artefatos locais
.venv/
**/__pycache__/
*.pyc
.pytest_cache/

# Fora do runtime
.git/
.gitignore
.spec/
.claude/
.vscode/
docker/
docker-compose*.yml
tests/
pytest.ini
requirements-dev.txt
README.md
